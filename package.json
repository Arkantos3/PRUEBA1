    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^37.2.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
